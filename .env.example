SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8773
SPRING_APPLICATION_NAME=prueba-api-b
SPRING_DATASOURCE_URL="jdbc:h2:mem:transaccionesdb;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE"
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.h2.Driver
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.H2Dialect
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=true
SPRING_H2_CONSOLE_ENABLED=true
SPRING_DATA_PAGEABLE_DEFAULT_PAGE_SIZE=10
SPRING_DATA_PAGEABLE_MAX_PAGE_SIZE=100
